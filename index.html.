<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>RelyPro Moving — Operations Hub</title>
<style>
:root{--orange:#f47721;--ink:#191919;--muted:#707782;--line:#e6e8eb;--bg:#f5f6f8;--card:#fff;--green:#18845b}
*{box-sizing:border-box}body{margin:0;font:15px/1.45 system-ui,-apple-system,Segoe UI,Roboto,Arial;background:var(--bg);color:var(--ink)}
header{background:#171717;color:#fff;padding:18px 22px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;border-bottom:4px solid var(--orange)}
.brand{font-size:21px;font-weight:850;letter-spacing:.2px}.brand span{color:var(--orange)}.sub{font-size:12px;color:#c9c9c9}
.wrap{max-width:1250px;margin:auto;padding:18px}.notice{background:#fff7ed;border:1px solid #fed7aa;padding:10px 12px;border-radius:10px;font-size:13px;margin-bottom:15px;color:#713f12}
nav{display:flex;gap:8px;overflow:auto;padding:0 0 14px}nav button,.btn{border:0;border-radius:9px;padding:10px 13px;font-weight:700;cursor:pointer;background:#eee;color:#222;white-space:nowrap}nav button.active,.btn.primary{background:var(--orange);color:white}button:hover{filter:brightness(.97)}.btn.dark{background:#222;color:#fff}.btn.light{background:#f0f1f3}.btn.danger{background:#fff0f0;color:#a21b1b}
.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:16px}.stat,.panel{background:var(--card);border:1px solid var(--line);border-radius:13px;padding:16px}.stat .label{color:var(--muted);font-size:13px}.stat .value{font-size:27px;font-weight:800;margin-top:3px}.stat .foot{font-size:12px;color:var(--muted)}
.cols{display:grid;grid-template-columns:1.15fr .85fr;gap:14px}.panel h2{font-size:17px;margin:0 0 13px}.section-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:8px 0 14px;flex-wrap:wrap}.section-head h1{font-size:23px;margin:0}.muted{color:var(--muted)}.small{font-size:12px}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:620px}th,td{text-align:left;padding:11px 9px;border-bottom:1px solid var(--line);font-size:13px;vertical-align:top}th{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}tr:last-child td{border-bottom:0}.pill{display:inline-block;padding:4px 8px;border-radius:99px;background:#f0f1f3;font-size:11px;font-weight:750}.pill.paid,.pill.completed{background:#dcfce7;color:#166534}.pill.booked,.pill.confirmed{background:#dbeafe;color:#1e40af}.pill.cancelled{background:#fee2e2;color:#991b1b}.pill.lead{background:#fef3c7;color:#92400e}
.formgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.field{display:flex;flex-direction:column;gap:5px}.field.full{grid-column:1/-1}label{font-size:12px;font-weight:750;color:#454a52}input,select,textarea{font:inherit;padding:10px;border:1px solid #d6d9de;border-radius:8px;background:#fff;width:100%;min-width:0}textarea{min-height:75px;resize:vertical}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:15px}.empty{padding:24px;text-align:center;color:var(--muted)}.hidden{display:none!important}.money{font-variant-numeric:tabular-nums}.calendar{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px}.day{background:white;border:1px solid var(--line);border-radius:8px;min-height:85px;padding:6px;font-size:12px}.day .num{font-weight:800}.event{background:#fff0e5;border-left:3px solid var(--orange);padding:4px;margin-top:4px;border-radius:3px;font-size:10px;overflow-wrap:anywhere}.calendar-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;gap:8px}
footer{padding:22px;text-align:center;color:var(--muted);font-size:12px}
@media(max-width:800px){.stats{grid-template-columns:repeat(2,minmax(0,1fr))}.cols{grid-template-columns:1fr}.wrap{padding:12px}.stat{padding:12px}.stat .value{font-size:23px}.section-head h1{font-size:21px}}
@media(max-width:430px){.formgrid{grid-template-columns:1fr}.field.full{grid-column:auto}.brand{font-size:18px}.stats{gap:8px}}
</style>
</head>
<body>
<header><div><div class="brand"><span>RELY</span>PRO MOVING</div><div class="sub">OPERATIONS HUB · CUSTOMER & JOB MANAGEMENT</div></div><button class="btn primary" onclick="openJob()">＋ New job</button></header>
<div class="wrap">
<div class="notice"><b>Starter version:</b> your records are saved in this browser on this device. They do not automatically sync between your phone and computer. Use sample data to explore; export regular backups. Don't enter sensitive payment-card details.</div>
<nav id="nav">
<button class="active" data-tab="dashboard">Dashboard</button><button data-tab="jobs">Jobs</button><button data-tab="customers">Customers</button><button data-tab="crew">Crew</button><button data-tab="expenses">Expenses</button><button data-tab="calendar">Calendar</button><button data-tab="reports">Reports</button><button data-tab="settings">Backup & Settings</button>
</nav>
<main>
<section id="dashboard" class="tab">
<div class="section-head"><div><h1>Business overview</h1><div class="muted">A quick view of your moving operations.</div></div><button class="btn light" onclick="openJob()">＋ Add a job</button></div>
<div class="stats">
<div class="stat"><div class="label">Upcoming jobs</div><div class="value" id="sUpcoming">0</div><div class="foot">Booked or confirmed</div></div>
<div class="stat"><div class="label">Completed jobs</div><div class="value" id="sCompleted">0</div><div class="foot">All recorded time</div></div>
<div class="stat"><div class="label">Revenue recorded</div><div class="value money" id="sRevenue">$0</div><div class="foot">Final job prices</div></div>
<div class="stat"><div class="label">Outstanding</div><div class="value money" id="sOutstanding">$0</div><div class="foot">Final price less payments</div></div>
</div>
<div class="cols"><div class="panel"><h2>Next jobs</h2><div id="nextJobs"></div></div><div class="panel"><h2>Money snapshot</h2><div class="stats" style="grid-template-columns:1fr 1fr"><div><div class="muted small">Expenses logged</div><div class="value money" id="sExpenses">$0</div></div><div><div class="muted small">Estimated profit*</div><div class="value money" id="sProfit">$0</div></div></div><p class="muted small">*Recorded final job prices minus recorded job expenses only. Add all relevant costs for a more useful estimate.</p><h2 style="margin-top:20px">Quick actions</h2><div class="actions"><button class="btn primary" onclick="openCustomer()">＋ Customer</button><button class="btn light" onclick="openExpense()">＋ Expense</button><button class="btn light" onclick="go('calendar')">View calendar</button></div></div></div>
</section>
<section id="jobs" class="tab hidden"><div class="section-head"><div><h1>Moving jobs</h1><div class="muted">Quotes, schedule, crew, final price and payments.</div></div><button class="btn primary" onclick="openJob()">＋ New job</button></div><div class="panel"><input id="jobSearch" placeholder="Search jobs, customer, address…" oninput="renderJobs()"><div class="table-wrap" id="jobsTable" style="margin-top:12px"></div></div></section>
<section id="customers" class="tab hidden"><div class="section-head"><div><h1>Customers</h1><div class="muted">Keep customer contacts and move details in one place.</div></div><button class="btn primary" onclick="openCustomer()">＋ New customer</button></div><div class="panel"><input id="customerSearch" placeholder="Search name, phone or email…" oninput="renderCustomers()"><div class="table-wrap" id="customersTable" style="margin-top:12px"></div></div></section>
<section id="crew" class="tab hidden"><div class="section-head"><div><h1>Crew directory</h1><div class="muted">Manage mover names and assign them to jobs.</div></div><button class="btn primary" onclick="openCrew()">＋ Add crew member</button></div><div class="panel"><div class="table-wrap" id="crewTable"></div></div></section>
<section id="expenses" class="tab hidden"><div class="section-head"><div><h1>Expenses</h1><div class="muted">Track fuel, supplies, labour and other job costs.</div></div><button class="btn primary" onclick="openExpense()">＋ Add expense</button></div><div class="panel"><div class="table-wrap" id="expensesTable"></div></div></section>
<section id="calendar" class="tab hidden"><div class="section-head"><div><h1>Job calendar</h1><div class="muted">Scheduled moves by date.</div></div><button class="btn primary" onclick="openJob()">＋ New job</button></div><div class="panel"><div class="calendar-head"><button class="btn light" onclick="changeMonth(-1)">← Previous</button><h2 id="monthLabel" style="margin:0"></h2><button class="btn light" onclick="changeMonth(1)">Next →</button></div><div class="calendar" id="calendarGrid"></div></div></section>
<section id="reports" class="tab hidden"><div class="section-head"><div><h1>Reports</h1><div class="muted">A basic view of recorded business performance.</div></div><button class="btn light" onclick="exportCSV()">Export jobs CSV</button></div><div class="stats"><div class="stat"><div class="label">Quoted total</div><div class="value money" id="rQuoted">$0</div></div><div class="stat"><div class="label">Final prices</div><div class="value money" id="rFinal">$0</div></div><div class="stat"><div class="label">Payments received</div><div class="value money" id="rPaid">$0</div></div><div class="stat"><div class="label">Expenses</div><div class="value money" id="rExpenses">$0</div></div></div><div class="panel"><h2>Job financial summary</h2><div class="table-wrap" id="reportTable"></div></div></section>
<section id="settings" class="tab hidden"><div class="section-head"><div><h1>Backup & settings</h1><div class="muted">Protect your records and move them between devices manually.</div></div></div><div class="cols"><div class="panel"><h2>Data backup</h2><p>Export a JSON backup file to save all customers, jobs, crew and expenses. To move records to another device, export here and import the backup there.</p><div class="actions"><button class="btn primary" onclick="backup()">Download backup</button><label class="btn light" style="cursor:pointer">Import backup<input type="file" accept=".json,application/json" onchange="restore(event)" style="display:none"></label></div><p class="muted small">Import replaces the data currently saved in this browser. Download a backup first.</p></div><div class="panel"><h2>Company details</h2><div class="formgrid"><div class="field"><label>Company name</label><input id="companyName" value="RelyPro Moving Inc."></div><div class="field"><label>Phone</label><input id="companyPhone" value="905-291-6556"></div><div class="field full"><label>Email</label><input id="companyEmail" value="sales@relypromoving.ca"></div></div><div class="actions"><button class="btn primary" onclick="saveSettings()">Save details</button><button class="btn danger" onclick="clearData()">Delete all local data</button></div></div></div></section>
</main></div>
<footer>RelyPro Moving Inc. · Starter operations hub · Keep backups of your records.</footer>
<div id="modal" class="hidden" style="position:fixed;inset:0;background:#0008;z-index:9;overflow:auto;padding:15px">
<div style="max-width:760px;margin:3vh auto;background:white;border-radius:15px;padding:20px;box-shadow:0 20px 60px #0003">
<div style="display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:15px"><h2 id="modalTitle" style="margin:0">Add record</h2><button class="btn light" onclick="closeModal()">✕ Close</button></div><form id="modalForm"><div id="modalFields" class="formgrid"></div><div class="actions"><button class="btn primary" type="submit">Save record</button><button class="btn light" type="button" onclick="closeModal()">Cancel</button></div></form>
</div></div>
<script>
const KEY='relypro_ops_v1';
let db={customers:[],jobs:[],crew:[{id:'crew1',name:'Alan'},{id:'crew2',name:'Kian'},{id:'crew3',name:'Ash'}],expenses:[],settings:{companyName:'RelyPro Moving Inc.',companyPhone:'905-291-6556',companyEmail:'sales@relypromoving.ca'}};
let editing=null, monthCursor=new Date();
const $=id=>document.getElementById(id);
const uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,7);
const money=n=>new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD',maximumFractionDigits:2}).format(Number(n)||0);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function load(){try{const x=JSON.parse(localStorage.getItem(KEY));if(x)db={...db,...x,settings:{...db.settings,...x.settings}}}catch(e){}}
function save(){localStorage.setItem(KEY,JSON.stringify(db));renderAll()}
function go(tab){document.querySelectorAll('.tab').forEach(x=>x.classList.add('hidden'));$(tab).classList.remove('hidden');document.querySelectorAll('nav button').forEach(b=>b.classList.toggle('active',b.dataset.tab===tab));if(tab==='calendar')renderCalendar()}
document.querySelectorAll('nav button').forEach(b=>b.onclick=()=>go(b.dataset.tab));
function customerName(id){return db.customers.find(c=>c.id===id)?.name||'—'}
function crewNames(ids){return (ids||[]).map(id=>db.crew.find(c=>c.id===id)?.name||id).join(', ')||'Unassigned'}
function totalPaid(j){return Number(j.deposit||0)+Number(j.additionalPaid||0)}
function finalPrice(j){return j.finalPrice!==''&&j.finalPrice!=null?Number(j.finalPrice):Number(j.quote||0)}
function statusPill(s){return `<span class="pill ${esc(String(s).toLowerCase())}">${esc(s||'Lead')}</span>`}
function tableOrEmpty(rows,head){return rows.length?`<table><thead><tr>${head.map(h=>`<th>${h}</th>`).join('')}</tr></thead><tbody>${rows.join('')}</tbody></table>`:'<div class="empty">Nothing here yet. Add a record to get started.</div>'}
function renderDashboard(){let today=new Date().toISOString().slice(0,10),up=db.jobs.filter(j=>['Booked','Confirmed'].includes(j.status)&&j.date>=today).length,done=db.jobs.filter(j=>j.status==='Completed').length,rev=db.jobs.filter(j=>j.status==='Completed').reduce((a,j)=>a+finalPrice(j),0),out=db.jobs.reduce((a,j)=>a+Math.max(0,finalPrice(j)-totalPaid(j)),0),ex=db.expenses.reduce((a,e)=>a+Number(e.amount||0),0);
$('sUpcoming').textContent=up;$('sCompleted').textContent=done;$('sRevenue').textContent=money(rev);$('sOutstanding').textContent=money(out);$('sExpenses').textContent=money(ex);$('sProfit').textContent=money(rev-ex);
let next=db.jobs.filter(j=>j.date>=today&&!['Cancelled','Completed'].includes(j.status)).sort((a,b)=>(a.date+a.time).localeCompare(b.date+b.time)).slice(0,6);
$('nextJobs').innerHTML=next.length?tableOrEmpty(next.map(j=>`<tr><td><b>${esc(j.date)}</b><br><span class="muted">${esc(j.time||'Time TBD')}</span></td><td>${esc(customerName(j.customerId))}<br><span class="muted">${esc(j.pickup||'')}</span></td><td>${statusPill(j.status)}</td><td>${money(j.quote)}</td><td><button class="btn light" onclick="editJob('${j.id}')">Open</button></td></tr>`),['Date','Customer / pickup','Status','Quote','']):'<div class="empty">No upcoming jobs yet. Add your first booking.</div>'}
function renderJobs(){let q=($('jobSearch')?.value||'').toLowerCase();let arr=db.jobs.filter(j=>([customerName(j.customerId),j.pickup,j.dropoff,j.id,j.status].join(' ').toLowerCase()).includes(q)).sort((a,b)=>(b.date||'').localeCompare(a.date||''));$('jobsTable').innerHTML=tableOrEmpty(arr.map(j=>`<tr><td><b>${esc(j.date||'—')}</b><br>${esc(j.time||'')}</td><td><b>${esc(customerName(j.customerId))}</b><br><span class="muted">${esc(j.pickup||'')} → ${esc(j.dropoff||'')}</span></td><td>${statusPill(j.status)}</td><td>${esc(crewNames(j.crewIds))}</td><td>${money(j.quote)}</td><td>${money(finalPrice(j))}</td><td>${money(Math.max(0,finalPrice(j)-totalPaid(j)))}</td><td><button class="btn light" onclick="editJob('${j.id}')">Edit</button></td></tr>`),['Date','Customer / route','Status','Crew','Quote','Final','Balance',''])}
function renderCustomers(){let q=($('customerSearch')?.value||'').toLowerCase();let arr=db.customers.filter(c=>[c.name,c.phone,c.email].join(' ').toLowerCase().includes(q));$('customersTable').innerHTML=tableOrEmpty(arr.map(c=>`<tr><td><b>${esc(c.name)}</b><br>${esc(c.phone||'')}</td><td>${esc(c.email||'')}</td><td>${esc(c.pickup||'')}</td><td>${esc(c.notes||'')}</td><td><button class="btn light" onclick="editCustomer('${c.id}')">Edit</button> <button class="btn light" onclick="openJob('${c.id}')">＋ Job</button></td></tr>`),['Customer','Email','Default pickup','Notes','Actions'])}
function renderCrew(){$('crewTable').innerHTML=tableOrEmpty(db.crew.map(c=>`<tr><td>${esc(c.name)}</td><td>${db.jobs.filter(j=>(j.crewIds||[]).includes(c.id)&&j.status!=='Cancelled').length} assigned job(s)</td><td><button class="btn light" onclick="editCrew('${c.id}')">Edit</button> <button class="btn danger" onclick="deleteCrew('${c.id}')">Remove</button></td></tr>`),['Crew member','Jobs','Actions'])}
function renderExpenses(){$('expensesTable').innerHTML=tableOrEmpty(db.expenses.slice().sort((a,b)=>(b.date||'').localeCompare(a.date||'')).map(e=>`<tr><td>${esc(e.date)}</td><td>${esc(e.category)}</td><td>${esc(e.jobId?customerName(db.jobs.find(j=>j.id===e.jobId)?.customerId):'General')}</td><td>${esc(e.note||'')}</td><td>${money(e.amount)}</td><td><button class="btn light" onclick="editExpense('${e.id}')">Edit</button> <button class="btn danger" onclick="del('expenses','${e.id}')">Delete</button></td></tr>`),['Date','Category','Job/customer','Note','Amount',''])}
function renderReports(){let sum=(f)=>db.jobs.reduce((a,j)=>a+f(j),0);$('rQuoted').textContent=money(sum(j=>Number(j.quote||0)));$('rFinal').textContent=money(sum(j=>finalPrice(j)));$('rPaid').textContent=money(sum(j=>totalPaid(j)));$('rExpenses').textContent=money(db.expenses.reduce((a,e)=>a+Number(e.amount||0),0));$('reportTable').innerHTML=tableOrEmpty(db.jobs.map(j=>`<tr><td>${esc(j.date)}</td><td>${esc(customerName(j.customerId))}</td><td>${esc(j.status)}</td><td>${money(j.quote)}</td><td>${money(finalPrice(j))}</td><td>${money(totalPaid(j))}</td><td>${money(finalPrice(j)-totalPaid(j))}</td></tr>`),['Date','Customer','Status','Quoted','Final','Paid','Balance'])}
function renderAll(){renderDashboard();renderJobs();renderCustomers();renderCrew();renderExpenses();renderReports();renderCalendar();$('companyName').value=db.settings.companyName||'';$('companyPhone').value=db.settings.companyPhone||'';$('companyEmail').value=db.settings.companyEmail||''}
function field(name,label,type='text',value='',opts=null,full=false,required=false){let content=type==='select'?`<select name="${name}" ${required?'required':''}>${opts.map(o=>`<option value="${esc(o.value)}" ${String(o.value)===String(value)?'selected':''}>${esc(o.label)}</option>`).join('')}</select>`:type==='textarea'?`<textarea name="${name}">${esc(value)}</textarea>`:`<input name="${name}" type="${type}" value="${esc(value)}" ${required?'required':''} ${type==='number'?'step="0.01"':''}>`;return `<div class="field ${full?'full':''}"><label>${label}${required?' *':''}</label>${content}</div>`}
function multiCrew(selected=[]){return `<div class="field full"><label>Assign crew (select one or more)</label><div style="display:flex;gap:12px;flex-wrap:wrap">${db.crew.map(c=>`<label style="font-weight:500"><input style="width:auto" type="checkbox" name="crewIds" value="${esc(c.id)}" ${selected.includes(c.id)?'checked':''}> ${esc(c.name)}</label>`).join('')||'Add crew members in the Crew tab first.'}</div></div>`}
function openModal(title,fields,record=null,kind){editing={kind,id:record?.id||null};$('modalTitle').textContent=title;$('modalFields').innerHTML=fields;$('modal').classList.remove('hidden');$('modalForm').dataset.kind=kind}
function closeModal(){$('modal').classList.add('hidden');editing=null}
function openCustomer(c=null){c=c||{};openModal(c.id?'Edit customer':'New customer',field('name','Full name','text',c.name||'',null,false,true)+field('phone','Phone','tel',c.phone||'')+field('email','Email','email',c.email||'')+field('pickup','Default pickup address','text',c.pickup||'',null,true)+field('notes','Notes / preferences','textarea',c.notes||'',null,true),c,'customer')}
function editCustomer(id){openCustomer(db.customers.find(c=>c.id===id))}
function openJob(customerId=null,j=null){j=j||{};let customers=[{value:'',label:'Select customer'},...db.customers.map(c=>({value:c.id,label:c.name+' — '+(c.phone||'no phone')}))];let status=['Lead','Quoted','Booked','Confirmed','In Progress','Completed','Cancelled'].map(x=>({value:x,label:x}));let today=new Date().toISOString().slice(0,10);openModal(j.id?'Edit moving job':'New moving job',field('customerId','Customer','select',j.customerId||customerId||'',customers,false,true)+field('status','Job status','select',j.status||'Lead',status)+field('date','Move date','date',j.date||today,null,false,true)+field('time','Start time','time',j.time||'09:00')+field('pickup','Pickup address','text',j.pickup||'',null,true)+field('dropoff','Delivery address','text',j.dropoff||'',null,true)+field('inventory','Inventory / services','textarea',j.inventory||'',null,true)+field('truck','Truck / vehicle','text',j.truck||'')+multiCrew(j.crewIds||[])+field('rate','Hourly rate (CAD)','number',j.rate??150)+field('estimatedHours','Estimated hours','number',j.estimatedHours??3)+field('quote','Quoted price (CAD)','number',j.quote??450)+field('actualHours','Actual hours','number',j.actualHours??'')+field('finalPrice','Final price (CAD)','number',j.finalPrice??'')+field('deposit','Deposit / payment received (CAD)','number',j.deposit??0)+field('additionalPaid','Additional payments (CAD)','number',j.additionalPaid??0)+field('notes','Job notes','textarea',j.notes||'',null,true)+field('id','Job reference','text',j.id||'Auto-generated',null,true),j,'job')}
function editJob(id){openJob(null,db.jobs.find(j=>j.id===id))}
function openCrew(c=null){c=c||{};openModal(c.id?'Edit crew member':'Add crew member',field('name','Crew member name','text',c.name||'',null,true,true)+field('phone','Phone (optional)','tel',c.phone||'')+field('role','Role','text',c.role||'Mover'),c,'crew')}
function editCrew(id){openCrew(db.crew.find(c=>c.id===id))}
function deleteCrew(id){if(confirm('Remove this crew member? Existing jobs may still reference them.')){db.crew=db.crew.filter(c=>c.id!==id);save()}}
function openExpense(e=null){e=e||{};let jobs=[{value:'',label:'General / not linked to a job'},...db.jobs.map(j=>({value:j.id,label:(j.date||'No date')+' — '+customerName(j.customerId)}))];openModal(e.id?'Edit expense':'Add expense',field('date','Date','date',e.date||new Date().toISOString().slice(0,10),null,false,true)+field('category','Category','select',e.category||'Fuel',['Fuel','Crew labour','Supplies','Truck rental','Parking / tolls','Repairs','Marketing','Other'].map(x=>({value:x,label:x})),false,true)+field('amount','Amount (CAD)','number',e.amount||'',null,false,true)+field('jobId','Link to job','select',e.jobId||'',jobs)+field('note','Description / receipt reference','text',e.note||'',null,true),e,'expense')}
function editExpense(id){openExpense(db.expenses.find(e=>e.id===id))}
function del(kind,id){if(confirm('Delete this record?')){db[kind]=db[kind].filter(x=>x.id!==id);save()}}
$('modalForm').addEventListener('submit',e=>{e.preventDefault();let f=new FormData(e.target),kind=e.target.dataset.kind,rec={};for(let [k,v] of f.entries()){if(k!=='crewIds')rec[k]=v}if(kind==='job')rec.crewIds=f.getAll('crewIds');let id=editing?.id||uid();rec.id=id;
if(kind==='customer'){let old=db.customers.find(x=>x.id===id);db.customers=old?db.customers.map(x=>x.id===id?rec:x):[rec,...db.customers]}
if(kind==='job'){['rate','estimatedHours','quote','actualHours','finalPrice','deposit','additionalPaid'].forEach(k=>rec[k]=rec[k]===''?'':Number(rec[k]));let old=db.jobs.find(x=>x.id===id);db.jobs=old?db.jobs.map(x=>x.id===id?rec:x):[rec,...db.jobs]}
if(kind==='crew'){let old=db.crew.find(x=>x.id===id);db.crew=old?db.crew.map(x=>x.id===id?rec:x):[...db.crew,rec]}
if(kind==='expense'){rec.amount=Number(rec.amount||0);let old=db.expenses.find(x=>x.id===id);db.expenses=old?db.expenses.map(x=>x.id===id?rec:x):[rec,...db.expenses]}
closeModal();save();});
function renderCalendar(){let y=monthCursor.getFullYear(),m=monthCursor.getMonth();$('monthLabel').textContent=monthCursor.toLocaleDateString('en-CA',{month:'long',year:'numeric'});let first=new Date(y,m,1),offset=(first.getDay()+6)%7,days=new Date(y,m+1,0).getDate(),arr=[];['Mon','Tue','Wed','Thu','Fri','Sat','Sun'].forEach(x=>arr.push(`<div class="muted small" style="padding:4px">${x}</div>`));for(let i=0;i<offset;i++)arr.push('<div class="day" style="background:#f7f7f7"></div>');for(let d=1;d<=days;d++){let date=`${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`,jobs=db.jobs.filter(j=>j.date===date&&!['Cancelled'].includes(j.status));arr.push(`<div class="day"><div class="num">${d}</div>${jobs.map(j=>`<div class="event" onclick="editJob('${j.id}')" title="Open job">${esc(j.time||'')} ${esc(customerName(j.customerId))}</div>`).join('')}</div>`)}$('calendarGrid').innerHTML=arr.join('')}
function changeMonth(n){monthCursor.setMonth(monthCursor.getMonth()+n);renderCalendar()}
function backup(){let blob=new Blob([JSON.stringify(db,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='relypro-backup-'+new Date().toISOString().slice(0,10)+'.json';a.click();URL.revokeObjectURL(a.href)}
function restore(e){let file=e.target.files[0];if(!file)return;let r=new FileReader();r.onload=()=>{try{let x=JSON.parse(r.result);if(!x.customers||!x.jobs||!x.crew||!x.expenses)throw Error('This file does not look like a RelyPro backup.');if(confirm('Import this backup and replace current local data?')){db=x;save();alert('Backup imported.')}}catch(err){alert('Could not import: '+err.message)}};r.readAsText(file);e.target.value=''}
function exportCSV(){let rows=[['Date','Customer','Status','Pickup','Dropoff','Crew','Quote','Final price','Deposit','Additional paid','Balance','Notes'],...db.jobs.map(j=>[j.date,customerName(j.customerId),j.status,j.pickup,j.dropoff,crewNames(j.crewIds),j.quote,finalPrice(j),j.deposit,j.additionalPaid,finalPrice(j)-totalPaid(j),j.notes])];let csv=rows.map(r=>r.map(v=>'"'+String(v??'').replace(/"/g,'""')+'"').join(',')).join('\r\n');let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv'}));a.download='relypro-jobs.csv';a.click();URL.revokeObjectURL(a.href)}
function saveSettings(){db.settings={companyName:$('companyName').value,companyPhone:$('companyPhone').value,companyEmail:$('companyEmail').value};save();alert('Company details saved.')}
function clearData(){if(confirm('This permanently deletes all RelyPro data saved in this browser. Download a backup first. Continue?')&&confirm('Are you completely sure?')){localStorage.removeItem(KEY);db={customers:[],jobs:[],crew:[],expenses:[],settings:{companyName:'RelyPro Moving Inc.',companyPhone:'905-291-6556',companyEmail:'sales@relypromoving.ca'}};save()}}
load();renderAll();
</script>
